{
  "type": "record",
  "name": "ProductImagePromotedPayload",
  "namespace": "com.ecommerce.events.image",
  "doc": "Business data for product image promotion event",
  "fields": [
    {
      "name": "image_id",
      "type": "string",
      "doc": "Unique image identifier (UUID)"
    },
    {
      "name": "product_id",
      "type": "string",
      "doc": "Target product identifier (UUID) - used as Kafka partition key"
    },
    {
      "name": "small_image_url",
      "type": "string",
      "doc": "Small image URL (400px) for thumbnails and listings"
    },
    {
      "name": "large_image_url",
      "type": "string",
      "doc": "Large image URL (800px) for product detail pages"
    }
  ]
}
